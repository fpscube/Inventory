[Unit]
Description=Inventaire personnel
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/inventory/app
Environment=INVENTORY_DATA_DIR=%h/.inventory
Environment=INVENTORY_TLS_DIR=%h/.inventory/tls
ExecStart=%h/.local/share/inventory/venv/bin/python -m app.serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
